;------------------------------------------------------------------------------
; ZDS II script file to run ZDSII and generate project file for
; Z8 Encore! ZiLOG Standard Library
;
; ZiLOG, Inc.
;------------------------------------------------------------------------------
;
;   to run: zds2ide @build_projects.scr with desired Z8 Encore!
;   installation bin directory in path
;
;   Library naming conventions:
;
;   <lib> <model> <frames> [<D>]
;     |      |        |      +--- Debug if exists, else no debug info
;     |      |        +---------- T = static frames, Y = dynamic frames
;     |      +------------------- S = Small model, L = large model
;     +-------------------------- ZSL = ZiLOG Standard Lib
;
; 

;
;
log "zsl1680.log"
log on

;------------------------------------------------------------------------------
; zsl
;
new project "zsl1680" "eZ8" "Library" "Z8F2480XN"

;------------------------------------------------------------------------------
; Add source files to the project
;
batch wait "add_gpio1680_projectfiles.scr"
batch wait "add_uart1680_projectfiles.scr"


;------------------------------------------------------------------------------
; zslSTD
; Model:  Small
; Frames: Static
; Debug:  Yes

set config "Debug"
set config "Small-Static-Debug(STD)"
;General tab
option general debug=TRUE
option general outputdir="STD"
;------------------------------------------------------------------------------
;C tab settings
;------------------------------------------------------------------------------
;General category
;----------------
option compiler optspeed=FALSE
option compiler watch=FALSE
option compiler model="Small"
;-------------------------------------------
; Code generation category
;-------------------------------------------
option compiler promote=TRUE
option compiler regvar=TRUE
option compiler optlink=TRUE
;----------------------
;Optimization category
;----------------------
option compiler reduceopt=TRUE
;
;------------------------------------------
;listing files category - keep all defaults
;------------------------------------------
;
;---------------------
;preprocessor category
;---------------------
option compiler stdinc="..\..\include\std;..\..\include\zilog"
defines compiler ADD "_DEBUG"
defines compiler ADD "__ZSLBUILD"

;----------------------
;assembler tab settings
;-----------------------
option assembler list=FALSE

;
;----------------------
;librarian tab settings 
;do not include the extention here as it will be appended by default.
;----------------------
option librarian outfile="zsl1680STD"




;------------------------------------------------------------------------------
