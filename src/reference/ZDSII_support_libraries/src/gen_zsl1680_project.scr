option compiler stdinc="..\..\include\std;..\..\include\zilog"
defines compiler ADD "_DEBUG"
defines compiler ADD "__ZSLBUILD"
defines compiler ADD "UART1_ISR_PRAM"
;----------------------
;assembler tab settings
;-----------------------
option assembler list=FALSE
;
;----------------------
;librarian tab settings 
;do not include the extention here as it will be appended by default.
;----------------------
option librarian outfile="zsl1680u1LYD"



;------------------------------------------------------------------------------
; zslLY
; Model:  Large
; Frames: Dynamic
; Debug:  No

set config "Release"
set config "Large-Dynamic-Release(LY)"
;General tab
option general debug=FALSE
option general outputdir="LY"
;------------------------------------------------------------------------------
;C tab settings
;------------------------------------------------------------------------------
;General category
;----------------
option compiler optspeed=TRUE
option compiler watch=FALSE
option compiler model="Large"
;-------------------------------------------
; Code generation category
;-------------------------------------------
option compiler promote=TRUE
option compiler regvar=TRUE
option compiler optlink=FALSE
;----------------------
;Optimization category
;----------------------
;------------------------------------------
;listing files category - keep all defaults
;------------------------------------------
;
;---------------------
;preprocessor category
;---------------------
option compiler stdinc="..\..\include\std;..\..\include\zilog"
defines compiler ADD "__ZSLBUILD"
defines compiler ADD "UART1_ISR_PRAM"
;----------------------
;assembler tab settings
;-----------------------
option assembler list=FALSE
;
;----------------------
;librarian tab settings 
;do not include the extention here as it will be appended by default.
;----------------------
option librarian outfile="zsl1680u1LY"



close project


;------------------------------------------------------------------------------
log off
;------------------------------------------------------------------------------


; Exit IDE, we're done
exit

