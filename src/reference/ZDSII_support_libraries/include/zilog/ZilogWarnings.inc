;  All Rights Reserved.

LAB_NOT_DEF       EQU 505 ; Label [name] not defined, treated as XREF 
ILL_CONST_EXP     EQU 507 ; Unexpected relocatable boolean/relational operand(s) 
ALLOC_ERROR       EQU 508 ; Block allocation size of zero encountered or
                          ;      Too many initializers for memory allocated 
RANGE_ERROR       EQU 535 ; Range error or
                          ;      PC has exceeded its maximal limit 
FLOAT_PREC        EQU 550 ; Floating Point Precision Overflow 
FLOAT_FLOW        EQU 551 ; Floating Point Overflow/Underflow 
CANT_INITIALIZE   EQU 556 ; Cannot place data in non-initializable segment
UNBALNCED_ASM_POP EQU 557 ; Unbalanced pop of warning state 
LDIR_WARNING      EQU 565 ; LDIR instruction replaced by equivalent macro
UNIMPLEMNTED_INST EQU 566 ; Unimplemented Instruction  
AMBIGUOUS_INST    EQU 568 ; LDX ... is ambiguous; assuming LDX ... 
COUNT_IGNORED     EQU 571 ; Repeat count on a TAG is only meaningfull within a STRUCT 
AMBIGUOUS_WITH    EQU 572 ; ... is ambiguous, using ..., not ...
USER_WARNING      EQU 576 ; Text on WARNING directive 
STRUCTNAME_MISMATCH  EQU 578 ; With name missmatch for object [struct name]
INEFFICIENT_INST  EQU 589 ; Inefficient instruction, suggest ... instead of ...
SPACEWARNING      EQU 608 ; Addresses on PAGE_E are error prone, check that ...
